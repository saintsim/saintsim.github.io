{
    "compilerOptions": {
        // "bundler" matches how Vite resolves the extensionless imports in src/
        // (the old "node" setting was removed in TypeScript 7)
        "moduleResolution": "bundler",
        // TypeScript 6+ defaults rootDir to this folder, which would emit built/src/*.js;
        // pin it to src/ to keep built/ flat (built/bus.js)
        "rootDir": "./src",
        "outDir": "./built",
        "allowJs": true,
        "module": "esnext",
        "target": "esnext",
        "lib": ["esnext", "dom"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["vite/client"]
    },
    "include": ["./src/**/*"]
}